ARG BASE_IMAGE=registry.lazycat.cloud/x/lzc-aipod-cuda:2a9aebc
ARG UV_VERSION=0.8.15

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-bin

FROM ${BASE_IMAGE} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_UID=1000
ARG USER_GID=1000
ARG PIP_INDEX_URL=http://wa.lan:10608/simple
ARG PIP_EXTRA_INDEX_URL=https://mirrors.ustc.edu.cn/pypi/simple
ARG MODEL_DIR=checkpoints/openaudio-s1-mini
ARG PRECOMPILE=0
ARG TORCH_VERSION=2.8.0
ARG TORCHAUDIO_VERSION=2.8.0
ARG TORCHVISION_VERSION=0.23.0
ARG TRITON_VERSION=3.4.0
ARG TORCH_WHL_URL=http://wa.lan:10608/packages/torch/torch-2.8.0-cp310-cp310-linux_aarch64.whl
ARG TORCHAUDIO_WHL_URL=http://wa.lan:10608/packages/torchaudio/torchaudio-2.8.0-cp310-cp310-linux_aarch64.whl
ARG TORCHVISION_WHL_URL=http://wa.lan:10608/packages/torchvision/torchvision-0.23.0-cp310-cp310-linux_aarch64.whl
ARG TRITON_WHL_URL=http://wa.lan:10608/packages/triton/triton-3.4.0-cp310-cp310-linux_aarch64.whl

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON=/usr/bin/python3 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    HOME=/tmp \
    USER=appuser \
    LOGNAME=appuser \
    LNAME=appuser \
    USERNAME=appuser \
    TORCHINDUCTOR_CACHE_DIR=/opt/torch-compile-cache \
    TRITON_CACHE_DIR=/opt/triton-cache \
    HF_HOME=/opt/hf-home

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' >/etc/apt/apt.conf.d/keep-cache; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      python3 \
      python3-dev \
      python3-venv \
      python3-pip \
      build-essential \
      cmake \
      pkg-config \
      git \
      curl \
      ca-certificates \
      ffmpeg \
      libsndfile1 \
      libsox-dev \
      libasound2-dev \
      libportaudio2 \
      portaudio19-dev; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

COPY --from=uv-bin /uv /uvx /usr/local/bin/

RUN set -eux; \
    mkdir -p /app /app/references /app/compile-cache/torch /app/compile-cache/triton /opt/torch-compile-cache /opt/triton-cache /opt/hf-home; \
    python3 -m venv ${VIRTUAL_ENV}; \
    chown -R ${USER_UID}:${USER_GID} /app /opt/torch-compile-cache /opt/triton-cache /opt/hf-home /opt/venv

WORKDIR /app

COPY pyproject.toml README.md docker/requirements.jetson-runtime.txt ./

RUN --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    ${VIRTUAL_ENV}/bin/python -m pip install --index-url ${PIP_INDEX_URL} --extra-index-url ${PIP_EXTRA_INDEX_URL} --trusted-host wa.lan pip setuptools wheel; \
    ${VIRTUAL_ENV}/bin/python -m pip install --trusted-host wa.lan \
      ${TORCH_WHL_URL} \
      ${TORCHAUDIO_WHL_URL} \
      ${TORCHVISION_WHL_URL} \
      ${TRITON_WHL_URL}

RUN --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    ${VIRTUAL_ENV}/bin/python -m pip install --index-url ${PIP_INDEX_URL} --extra-index-url ${PIP_EXTRA_INDEX_URL} --trusted-host wa.lan -r requirements.jetson-runtime.txt

COPY . .

RUN set -eux; \
    mkdir -p /opt/torch-compile-cache /opt/triton-cache; \
    cp -a /app/compile-cache/torch/. /opt/torch-compile-cache/ 2>/dev/null || true; \
    cp -a /app/compile-cache/triton/. /opt/triton-cache/ 2>/dev/null || true

RUN set -eux; \
    test -f ${MODEL_DIR}/model.pth; \
    test -f ${MODEL_DIR}/codec.pth; \
    test -f ${MODEL_DIR}/config.json; \
    test -f ${MODEL_DIR}/tokenizer.tiktoken; \
    test -f ${MODEL_DIR}/special_tokens.json

RUN --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    ${VIRTUAL_ENV}/bin/python -m pip install --no-build-isolation --no-deps --index-url ${PIP_INDEX_URL} --extra-index-url ${PIP_EXTRA_INDEX_URL} --trusted-host wa.lan .

RUN set -eux; \
    chown -R ${USER_UID}:${USER_GID} /app /opt/torch-compile-cache /opt/triton-cache /opt/hf-home

USER ${USER_UID}:${USER_GID}

RUN set -eux; \
    if [ "${PRECOMPILE}" = "1" ]; then \
      if python tools/jetson/prewarm_compile_cache.py \
          --llama-checkpoint-path ${MODEL_DIR} \
          --decoder-checkpoint-path ${MODEL_DIR}/codec.pth \
          --decoder-config-name modded_dac_vq \
          --device cuda \
          --half \
          --compile; then \
        touch /opt/torch-compile-cache/.compile-ready; \
      else \
        echo 'Jetson precompile failed, continuing with runtime compile fallback'; \
      fi; \
    fi

FROM ${BASE_IMAGE} AS runtime

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_UID=1000
ARG USER_GID=1000
ARG API_SERVER_NAME=0.0.0.0
ARG API_SERVER_PORT=8080
ARG MODEL_DIR=checkpoints/openaudio-s1-mini

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    HOME=/tmp \
    USER=appuser \
    LOGNAME=appuser \
    LNAME=appuser \
    USERNAME=appuser \
    API_SERVER_NAME=${API_SERVER_NAME} \
    API_SERVER_PORT=${API_SERVER_PORT} \
    LLAMA_CHECKPOINT_PATH=/app/${MODEL_DIR} \
    DECODER_CHECKPOINT_PATH=/app/${MODEL_DIR}/codec.pth \
    DECODER_CONFIG_NAME=modded_dac_vq \
    TORCHINDUCTOR_CACHE_DIR=/opt/torch-compile-cache \
    TRITON_CACHE_DIR=/opt/triton-cache \
    HF_HOME=/opt/hf-home \
    COMPILE=auto

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' >/etc/apt/apt.conf.d/keep-cache; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      python3 \
      python3-venv \
      ffmpeg \
      libsndfile1 \
      libsox-dev \
      libasound2 \
      libportaudio2 \
      curl; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    mkdir -p /app/references /opt/torch-compile-cache /opt/triton-cache /opt/hf-home; \
    chown -R ${USER_UID}:${USER_GID} /app /opt/torch-compile-cache /opt/triton-cache /opt/hf-home

WORKDIR /app

COPY --from=builder --chown=${USER_UID}:${USER_GID} /opt/venv /opt/venv
COPY --from=builder --chown=${USER_UID}:${USER_GID} /app /app
COPY --from=builder --chown=${USER_UID}:${USER_GID} /opt/torch-compile-cache /opt/torch-compile-cache
COPY --from=builder --chown=${USER_UID}:${USER_GID} /opt/triton-cache /opt/triton-cache
COPY --from=builder --chown=${USER_UID}:${USER_GID} /opt/hf-home /opt/hf-home

EXPOSE ${API_SERVER_PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD curl -f http://localhost:${API_SERVER_PORT}/v1/health || exit 1

USER ${USER_UID}:${USER_GID}
ENTRYPOINT ["/bin/bash", "/app/tools/jetson/start_server.sh"]
